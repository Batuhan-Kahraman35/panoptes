[Unit]
Description=DVR Ekran yonetim paneli
After=network-online.target
Wants=network-online.target

[Service]
User=dvr
Environment=DVR_DATA=/var/lib/dvr-ekran PORT=8765 GO2RTC_API=http://127.0.0.1:1984 PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/dvr-ekran.env
ExecStart=/usr/bin/python3 /opt/dvr-ekran/app/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
